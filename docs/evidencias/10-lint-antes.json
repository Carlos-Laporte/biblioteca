:2,"message":"Review this redundant assignment: \"multa\" already holds the assigned value along all execution paths.","line":56,"column":15,"messageId":"reviewAssignment","endLine":56,"endColumn":16},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 10.","line":57,"column":30,"messageId":"noMagic","endLine":57,"endColumn":32},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 2.5.","line":58,"column":28,"messageId":"noMagic","endLine":58,"endColumn":31},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 10.","line":60,"column":15,"messageId":"noMagic","endLine":60,"endColumn":17},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 2.5.","line":60,"column":20,"messageId":"noMagic","endLine":60,"endColumn":23},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 10.","line":60,"column":40,"messageId":"noMagic","endLine":60,"endColumn":42},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 5.","line":60,"column":46,"messageId":"noMagic","endLine":60,"endColumn":47},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 150.","line":62,"column":17,"messageId":"noMagic","endLine":62,"endColumn":20},{"ruleId":"@typescript-eslint/no-magic-numbers","severity":1,"message":"No magic number: 150.","line":63,"column":15,"messageId":"noMagic","endLine":63,"endColumn":18}],"suppressedMessages":[],"errorCount":19,"fatalErrorCount":0,"warningCount":21,"fixableErrorCount":5,"fixableWarningCount":2,"source":"import { ArgumentoInvalidoError, RegraNegocioError } from './erros';\nimport { PerfilUsuario, ResultadoEmprestimo } from './tipos';\n\nexport class CalculadoraEmprestimo {\n  validarEmprestimo(\n    perfil: PerfilUsuario,\n    livrosEmprestados: number,\n    livrosSolicitados: number,\n    possuiPendencia: boolean,\n  ): ResultadoEmprestimo {\n    if (perfil == null) {\n      throw new ArgumentoInvalidoError('Perfil de usuário inválido');\n    }\n    if (!Number.isInteger(livrosEmprestados) || livrosEmprestados < 0) {\n      throw new ArgumentoInvalidoError('Quantidade de livros inválida');\n    }\n    if (!Number.isInteger(livrosSolicitados) || livrosSolicitados < 1) {\n      throw new ArgumentoInvalidoError('Quantidade de livros inválida');\n    }\n    if (typeof possuiPendencia != 'boolean') {\n      throw new ArgumentoInvalidoError('Indicador de pendência inválido');\n    }\n    var limite = 0;\n    var prazo = 0;\n    if (perfil == 'GRADUACAO') {\n      limite = 3;\n      prazo = 15;\n    } else if (perfil == 'POS_GRADUACAO') {\n      limite = 5;\n      prazo = 30;\n    } else if (perfil == 'PROFESSOR') {\n      limite = 10;\n      prazo = 45;\n    } else {\n      throw new ArgumentoInvalidoError('Perfil de usuário inválido');\n    }\n    if (possuiPendencia == true) {\n      throw new RegraNegocioError('PENDENCIA', 'Usuário possui pendências');\n    }\n    let total = livrosEmprestados + livrosSolicitados;\n    if (total > limite) {\n      throw new RegraNegocioError('LIMITE_EXCEDIDO', 'Limite de livros excedido');\n    }\n    return { aprovado: true, perfil: perfil, limite: limite, totalAposEmprestimo: total, prazoDevolucaoDias: prazo };\n  }\n\n  calcularMulta(diasAtraso: number, perfil: PerfilUsuario): number {\n    if (perfil == null || (perfil != 'GRADUACAO' && perfil != 'POS_GRADUACAO' && perfil != 'PROFESSOR')) {\n      throw new ArgumentoInvalidoError('Perfil de usuário inválido');\n    }\n    if (!Number.isInteger(diasAtraso) || diasAtraso < 0) {\n      throw new ArgumentoInvalidoError('Quantidade de dias inválida');\n    }\n    var multa = 0;\n    if (diasAtraso <= 3) {\n      multa = 0;\n    } else if (diasAtraso <= 10) {\n      multa = diasAtraso * 2.5;\n    } else {\n      multa = 10 * 2.5 + (diasAtraso - 10) * 5;\n    }\n    if (multa > 150) {\n      multa = 150;\n    }\n    return multa;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\src\\domain\\erros.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\src\\domain\\tipos.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\tests\\elegibilidade-bloqueios.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\tests\\elegibilidade.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\tests\\multa-teto.test.ts","messages":[{"ruleId":"id-length","severity":1,"message":"Identifier name 'd' is too short (< 2).","line":34,"column":46,"messageId":"tooShort","endLine":34,"endColumn":47}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, beforeEach } from 'vitest';\nimport { CalculadoraEmprestimo } from '../src/domain/CalculadoraEmprestimo';\nimport { PerfilUsuario } from '../src/domain/tipos';\n\ndescribe('RF02 — Teto máximo da multa (R$ 150,00)', () => {\n  let calculadora: CalculadoraEmprestimo;\n\n  beforeEach(() => {\n    // Arrange (comum)\n    calculadora = new CalculadoraEmprestimo();\n  });\n\n  it.each([\n    ['CT26 — teto − 1 dia', 34, 145],\n    ['CT27 — ponto exato do teto', 35, 150],\n    ['CT28 — teto + 1 dia', 36, 150],\n    ['CT29 — valor extremo', 1000, 150],\n  ])('%s: %i dias => R$ %d', (_descricao, dias, esperado) => {\n    // Arrange\n    const perfil = PerfilUsuario.POS_GRADUACAO;\n\n    // Act\n    const multa = calculadora.calcularMulta(dias, perfil);\n\n    // Assert\n    expect(multa).toBe(esperado);\n  });\n\n  it('a multa nunca ultrapassa R$ 150,00 para 0..400 dias', () => {\n    // Arrange\n    const dias = Array.from({ length: 401 }, (_, i) => i);\n\n    // Act\n    const maiorMulta = Math.max(...dias.map((d) => calculadora.calcularMulta(d, PerfilUsuario.PROFESSOR)));\n\n    // Assert\n    expect(maiorMulta).toBe(150);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\tests\\multa.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\usuario\\OneDrive\\Desktop\\trabalho vanessa\\vitest.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]