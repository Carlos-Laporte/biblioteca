# Copie para .env e ajuste. O .env NÃO deve ser commitado.
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=troque-esta-senha
# Popular o banco com dados de exemplo na primeira subida (true/false)
SEED=true
LOG_LEVEL=info

# Desenvolvimento local da API (npm run dev:api), com um PostgreSQL acessível:
# DATABASE_URL=postgres://biblioteca:troque-esta-senha@localhost:5432/biblioteca

# Testes de integração contra um banco já existente (o nome do banco precisa conter "teste").
# Sem esta variável, os testes sobem um PostgreSQL descartável via Testcontainers.
# BIBLIOTECA_TEST_DATABASE_URL=postgres://teste:teste@localhost:5433/biblioteca_teste
