{
  "name": "calculadora-emprestimo",
  "version": "1.0.0",
  "private": true,
  "description": "Módulo de regras de negócio de empréstimos e multas de uma biblioteca universitária (TDD + TypeScript).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o reports/eslint.json",
    "mutantes": "node scripts/mutantes.mjs",
    "mutation:auto": "stryker run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "evidencias": "node scripts/gerar-evidencias.mjs",
    "qualidade": "npm run typecheck && npm run lint && npm run coverage && npm run mutantes && npm run mutation:auto",
    "docker:subir": "node scripts/docker.mjs subir",
    "docker:qualidade": "node scripts/docker.mjs qualidade",
    "docker:parar": "node scripts/docker.mjs parar",
    "docker:logs": "node scripts/docker.mjs logs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
