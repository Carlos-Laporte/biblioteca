{
  "name": "calculadora-emprestimo",
  "version": "1.0.0",
  "private": true,
  "description": "Módulo de regras de negócio de empréstimos e multas de uma biblioteca universitária (TDD + TypeScript).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:report": "eslint . -f json -o reports/eslint.json",
    "mutantes": "node scripts/mutantes.mjs",
    "mutation:auto": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
